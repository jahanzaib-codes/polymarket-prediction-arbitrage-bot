# ===============================================
# Polymarket Prediction & Arbitrage Bot Configuration
# ===============================================

# 1. Polygon / EVM Credentials
# Private key for your Polygon wallet that holds USDC
POLYGON_PRIVATE_KEY="YOUR_POLYGON_PRIVATE_KEY_HERE"
POLYGON_RPC_URL="https://polygon-rpc.com"

# 2. Polymarket CLOB API Credentials
# Obtained from polymarket.com or via client onboarding
POLYMARKET_HOST="https://clob.polymarket.com"
POLY_API_KEY=""
POLY_API_SECRET=""
POLY_API_PASSPHRASE=""

# 3. Arbitrage & Trading Settings
MIN_ARBITRAGE_SPREAD_PERCENT=1.5      # Minimum edge required (YES + NO <= $0.985)
TRADE_SIZE_USDC=50.0                  # Order size per leg in USDC
MAX_OPEN_POSITIONS=5                  # Concurrent risk limits
SIMULATION_MODE=true                  # Set false for live real-capital execution

# 4. Target Market Categories
ENABLE_5MIN_BTC_MARKETS=true
ENABLE_POLITICAL_MARKETS=true
SLIPPAGE_TOLERANCE_PERCENT=1.0
